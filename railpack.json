{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "buildFrontend": {
      "inputs": [
        { "step": "packages:mise" },
        { "local": true, "include": ["."] }
      ],
      "commands": ["cd frontend/frontend-vue && npm install && npm run build"]
    },
    "build": {
      "inputs": [{ "step": "buildFrontend" }]
    }
  }
}